# Internal rootless Caddy gateway for arkfile-bitcart.
# Publishes two loopback-only listeners:
#   127.0.0.1:28080 -- public checkout and strictly scoped public_api_paths
#   127.0.0.1:29080 -- SSH-tunnel-only full API and optional on-demand admin UI

{
	auto_https off
	admin off
}

(strip_ip_headers) {
	header_up -X-Forwarded-For
	header_up -X-Real-IP
	header_up -Forwarded
}

(proxy_public_api) {
	uri strip_prefix /api
	reverse_proxy backend:8000 {
		import strip_ip_headers
	}
}

:28080 {
	log {
		output discard
	}

	# Permitted checkout static routes (GET and HEAD only).
	@checkout_static {
		method GET HEAD
		path /i/* /checkout/* /embed/* /modal/* /refunds/*
	}

	# Permitted public_api_paths (strict positive method-and-path matching).
	# POST /api/invoices creates an invoice (exact path only).
	@api_invoices_create {
		method POST
		path /api/invoices
	}

	# GET /api/invoices/count supports arkfile-admin payments check.
	@api_invoices_count {
		method GET
		path /api/invoices/count
	}

	# GET /api/invoices/{id} matches a single invoice ID segment only and
	# excludes batch, export, order_id, customer, details, and refunds routes.
	@api_invoices_get_one {
		method GET
		path_regexp ^/api/invoices/[A-Za-z0-9_-]+$
		not path /api/invoices/batch /api/invoices/export /api/invoices/order_id
	}

	# GET /api/stores/{id} and GET /api/stores/{id}/rates (read-only).
	@api_stores_get {
		method GET
		path_regexp ^/api/stores/[A-Za-z0-9_-]+(/rates)?$
		not path /api/stores/batch /api/stores/export /api/stores/count
	}

	# GET /api/ws/invoices/{id} provides live WebSocket status updates to checkout.
	@api_ws_invoice {
		method GET
		path_regexp ^/api/ws/invoices/[A-Za-z0-9_-]+$
	}

	# GET /api/manage/policies (read-only) is queried by the checkout SPA.
	@api_manage_policies {
		method GET
		path /api/manage/policies
	}

	# GET /api/cryptos* and GET /api/tor/services (read-only).
	@api_cryptos_and_tor {
		method GET
		path /api/cryptos /api/cryptos/* /api/tor/services
	}

	handle @checkout_static {
		reverse_proxy checkout:80 {
			import strip_ip_headers
		}
	}

	handle @api_invoices_create {
		import proxy_public_api
	}

	handle @api_invoices_count {
		import proxy_public_api
	}

	handle @api_invoices_get_one {
		import proxy_public_api
	}

	handle @api_stores_get {
		import proxy_public_api
	}

	handle @api_ws_invoice {
		import proxy_public_api
	}

	handle @api_manage_policies {
		import proxy_public_api
	}

	handle @api_cryptos_and_tor {
		import proxy_public_api
	}

	# Return 404 for all other paths and HTTP methods (/, /admin*, /api/token*,
	# /api/users*, /api/wallets*, /api/invoices/batch, /api/invoices/export,
	# PATCH /api/invoices/*/customer, /api/backups*, /api/plugins*, etc.).
	handle {
		respond 404
	}
}

:29080 {
	log {
		output discard
	}

	handle_path /api/* {
		reverse_proxy backend:8000 {
			import strip_ip_headers
		}
	}

	handle {
		reverse_proxy admin:4000 {
			import strip_ip_headers
		}
	}
}
