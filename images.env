# Pinned container image references for arkfile-bitcart.
# Run `sudo bash scripts/pin-digests.sh` on the host to resolve floating tags
# (such as :stable or :17-alpine) into immutable @sha256 digests.

IMAGE_DATABASE=docker.io/pgautoupgrade/pgautoupgrade:17-alpine
IMAGE_REDIS=docker.io/library/redis:7-alpine
IMAGE_BITCOIN=docker.io/bitcart/bitcart-btc:stable
IMAGE_MONERO=docker.io/bitcart/bitcart-xmr:stable
IMAGE_BACKEND=docker.io/bitcart/bitcart:stable
IMAGE_CHECKOUT=docker.io/bitcart/bitcart-checkout:stable
IMAGE_ADMIN=docker.io/bitcart/bitcart-admin:stable
IMAGE_GATEWAY=docker.io/library/caddy:2.11.4-alpine
