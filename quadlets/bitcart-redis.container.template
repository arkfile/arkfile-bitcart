[Unit]
Description=Bitcart Redis broker on internal network (rootless)
After=network-online.target

[Container]
# Bitcart has no Redis password setting. Protected mode would reject backend
# and worker on the bridge network, so it is disabled. Redis stays reachable
# only by containers on the internal bitcart-data network, with no published ports.
Image=__IMAGE_REDIS__
ContainerName=redis
Network=bitcart-data.network
User=redis
Exec=redis-server --protected-mode no --save "" --appendonly no
DropCapability=ALL
NoNewPrivileges=true
HealthCmd=redis-cli ping
HealthInterval=15s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=10s

[Service]
Restart=on-failure
RestartSec=5s
MemoryMax=96M

[Install]
WantedBy=default.target
