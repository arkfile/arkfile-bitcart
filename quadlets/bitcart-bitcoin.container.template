[Unit]
Description=Bitcart watch-only Bitcoin Electrum RPC daemon (rootless)
After=network-online.target

[Container]
Image=__IMAGE_BITCOIN__
ContainerName=bitcoin
Network=bitcart-coins.network
EnvironmentFile=/home/bitcart/secrets/bitcoin.env
Volume=bitcart-btc-data.volume:/data
DropCapability=ALL
AddCapability=CHOWN DAC_OVERRIDE SETGID SETUID
HealthCmd=python3 -c "import socket; s=socket.create_connection(('127.0.0.1', 5000), 3); s.close()"
HealthInterval=30s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=30s

[Service]
Restart=on-failure
RestartSec=5s
MemoryMax=256M

[Install]
WantedBy=default.target
