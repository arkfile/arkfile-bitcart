[Unit]
Description=Bitcart background worker and webhook sender (rootless)
After=bitcart-database.service bitcart-redis.service bitcart-bitcoin.service bitcart-monero.service bitcart-backend.service
Requires=bitcart-database.service bitcart-redis.service bitcart-bitcoin.service bitcart-backend.service
Wants=bitcart-monero.service

[Container]
Image=__IMAGE_BACKEND__
ContainerName=worker
Exec=just worker
Network=bitcart-data.network
Network=bitcart-coins.network
EnvironmentFile=/home/bitcart/secrets/backend.env
Volume=bitcart-datadir.volume:/datadir
Volume=bitcart-backups.volume:/backups
Volume=bitcart-plugins.volume:/plugins
DropCapability=ALL
AddCapability=CHOWN DAC_OVERRIDE FOWNER SETGID SETUID

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120
MemoryMax=512M

[Install]
WantedBy=default.target
