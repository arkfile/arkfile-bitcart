# arkfile-bitcart operator configuration template
# Copy to /etc/arkfile-bitcart/bitcart.conf and restrict permissions:
#   sudo install -d -m 0700 /etc/arkfile-bitcart
#   sudo install -m 0600 bitcart.conf.example /etc/arkfile-bitcart/bitcart.conf
#
# Mainnet only. Watch-only wallet keys only. Never place spending private keys
# or seed phrases (xprv/yprv/zprv/tprv/uprv/vprv or Monero spend keys) in this file.

# Public domain served by host Caddy with automatic Let's Encrypt TLS 1.3.
# Point both A (and optionally AAAA) DNS records to this VPS before deploy.
PAY_DOMAIN=pay.example.com

# Enabled cryptocurrencies (comma-separated, mainnet only).
# Supported values: btc,xmr or btc
BITCART_CRYPTOS=btc,xmr

# External Bitcoin Electrum server (host:port:s for TLS).
# Electrum /data/config is always seeded with {"auto_connect": false} so wallet
# subscriptions never silently fail over to random public Electrum peers.
BTC_SERVER=bitcoin-mainnet.blockstream.info:50002:s

# Keep BTC_ONESERVER=false when using a public Electrum server so Electrum can
# still cross-check SPV block headers across peers without leaking wallet
# scripthashes. Set BTC_ONESERVER=true when BTC_SERVER is your own Electrum server.
BTC_ONESERVER=false

# External Monero daemon URL(s), comma-separated (mainnet only).
XMR_SERVER=https://xmr-node.cakewallet.com:18081

# Required confirmation floors enforced by Arkfile at invoice creation time.
# BTC_TX_SPEED must be >= 1; XMR_TX_SPEED must be >= 5.
BTC_TX_SPEED=1
XMR_TX_SPEED=5

# Bitcart internal log retention policy in days.
BITCART_LOG_RETENTION_DAYS=21

# Tenants are provisioned only when their watch-only keys are set.
# Prod-only, test-only, and both are valid. At least one tenant's watch-only
# keys are required. A partial tenant (some of that tenant's keys empty) is
# rejected. Leave the other tenant's fields empty to skip it. An unrequested
# tenant is not deleted on a later run.
#
# A test-only first deploy (TEST_* filled, every PROD_* wallet field empty)
# validates this stack against a test Arkfile host (test.example.com) before
# any production keys are placed on this VPS. Add prod later by filling PROD_*
# and running scripts/update.sh. That creates only the missing prod tenant and
# preserves the existing tenant's PostgreSQL data, wallets, store, and
# invoice_management token.
#
# Prod is requested when PROD_BTC_XPUB or any PROD_XMR_* field is non-empty.
# Test is requested when ENABLE_TEST_TENANT=true (any case) or TEST_BTC_XPUB
# or any TEST_XMR_* field is non-empty. When BITCART_CRYPTOS includes xmr, a
# requested tenant must include a mainnet primary address, a 64-hex private
# view key, and an integer restore height if a height is set.

# Production tenant (prod@pay.internal -> store PROD_STORE_NAME or "arkfile-prod").
# Leave every PROD_* wallet field empty for a test-only deployment.
# Optional store display name shown on Bitcart checkout, confirming, and receipt
# pages (for example files.example.com). Leave empty for "arkfile-prod". Setting
# PROD_STORE_NAME alone does not enable the prod tenant.
PROD_STORE_NAME=
# Use a mainnet BIP84 watch-only account extended public key (zpub..., or xpub/ypub).
PROD_BTC_XPUB=
# Mainnet Monero primary address (starts with 4, 95 characters), private view key
# (64 hex characters), and integer wallet restore block height.
PROD_XMR_ADDRESS=
PROD_XMR_PRIVATE_VIEW_KEY=
PROD_XMR_RESTORE_HEIGHT=

# Isolated test tenant (test@pay.internal -> store TEST_STORE_NAME or "arkfile-test").
# Leave ENABLE_TEST_TENANT=false and every TEST_* wallet field empty for a prod-only
# deployment. Setting ENABLE_TEST_TENANT=true, supplying TEST_BTC_XPUB, or
# supplying any TEST_XMR_* field enables the test tenant. When both tenants
# are enabled, use a separate mainnet BIP84 account zpub and a separate Monero
# wallet or account from prod.
ENABLE_TEST_TENANT=false
# Optional store display name shown on Bitcart checkout, confirming, and receipt
# pages (for example test.example.com). Leave empty for "arkfile-test". Setting
# TEST_STORE_NAME alone does not enable the test tenant.
TEST_STORE_NAME=
TEST_BTC_XPUB=
TEST_XMR_ADDRESS=
TEST_XMR_PRIVATE_VIEW_KEY=
TEST_XMR_RESTORE_HEIGHT=

# Backup settings used by scripts/backup.sh.
BACKUP_DIR=/var/backups/arkfile-bitcart
BACKUP_RETENTION_DAYS=14
# Optional off-host encryption recipient for backups (set at most one).
BACKUP_AGE_RECIPIENT=
BACKUP_GPG_RECIPIENT=
